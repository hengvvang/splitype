<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>splitype</title>
    <welcome>splitype is a block-based Markdown editor built with Rust and GPUI.</welcome>
    <options customize="never" require-scripts="true" rootVolumeOnly="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="10.15"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default">
            <line choice="splitype"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="splitype" title="Install splitype" description="Install splitype to /Applications">
        <pkg-ref id="com.hengvvang.splitype"/>
    </choice>
    <pkg-ref id="com.hengvvang.splitype" version="__SPLITYPE_VERSION__" onConclusion="none">#splitype-component.pkg</pkg-ref>
</installer-gui-script>
