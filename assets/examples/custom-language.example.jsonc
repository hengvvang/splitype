// splitype custom language pack example.
//
// Save a copy as .json or .jsonc and import it from Language -> Add
// Language Config. The file is a partial patch: every omitted string key
// inherits from the built-in base language — a pack whose id is a built-in
// language (zh-CN) inherits that language, anything else inherits English.
//
// Format rules:
// - `id` is required and must be a BCP 47-style id that does not replace a
//   built-in language (zh-CN / en-US).
// - `name` is required; `author` is optional and shown in the menu.
// - `strings` keys must be canonical UI string ids; unknown keys and empty
//   values are hard errors, so typos fail the import loudly.
// - Any omitted key inherits the base language; list only what you change.
{
  "id": "ja-JP",
  "name": "日本語",
  "author": "Tanaka",
  "strings": {
    "menu_file": "ファイル",
    "menu_export": "エクスポート",
    "menu_language": "言語",
    "menu_theme": "テーマ",
    "info_dialog_ok": "OK",
    "menu_save": "保存",
    "menu_quit": "終了"
  }
}
