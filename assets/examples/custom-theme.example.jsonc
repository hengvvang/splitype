// splitype theme family example.
//
// Save a copy as .json or .jsonc, fill in the values you want to customize,
// then import it from Theme -> Add Theme Config. The file describes one
// theme *family*: a name, an optional author, and one or more variant
// themes. Every variant carries a partial style patch; any omitted section
// or field inherits from the variant's `base` theme, and a missing `base`
// bottoms out at the built-in dark theme.
//
// Format rules:
// - `name` is required and non-empty; `themes` must contain at least one
//   variant with a unique, non-empty `name`.
// - `appearance` is "dark" or "light" and selects the variant used when
//   switching appearance in Settings.
// - `base` is "family" or "family.variant" (case-insensitive), e.g.
//   "splitype", "splitype.dark", or another family you imported.
// - Colors are `#rrggbb` or `#rrggbbaa` hex strings (short `#rgb` / `#rgba`
//   forms are also accepted).
// - Unknown keys are hard errors, so typos fail the import loudly.
// - `colors`, `dimensions`, `typography`, and `placeholders` accept any of
//   the tokens listed in Settings -> Splitype Core -> Color Overrides.
// - `extension` overrides plugin-contributed tokens keyed by token id.
{
  // Required. Shown as the theme name in the Theme menu.
  "name": "Night Writer",
  // Optional. The Theme menu displays imported themes as "Variant · Author".
  "author": "Ada",

  "themes": [
    {
      // Required. Variant display name.
      "name": "Dark",
      // Optional. Whether this is a dark or light variant.
      "appearance": "dark",
      "style": {
        // Optional. Everything not overridden below inherits from this
        // theme's base chain.
        "base": "splitype.dark",
        "colors": {
          "focus_accent": "#8b5cf6",
          "selection": "#8b5cf640",
          "editor_background": "#131316"
        },
        "dimensions": {
          "block_gap": 12.0,
          "editor_padding": 32.0
        },
        "typography": {
          "text_size": 17.5
        },
        "placeholders": {
          "empty_editing": ""
        }
        // "extension": { "plugin.token.id": "#8b5cf6" }
      }
    },
    {
      "name": "Light",
      "appearance": "light",
      "style": {
        // A variant can also build on another variant of the same family.
        "base": "night_writer.dark",
        "colors": {
          "editor_background": "#fafaf9",
          "focus_accent": "#7c3aed"
        }
      }
    }
  ]
}
